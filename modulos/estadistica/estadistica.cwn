# =====================================================================
# estadistica.cwn — estadística descriptiva (implementado en C)
# ---------------------------------------------------------------------
# Cálculos rápidos sobre listas (ver "codigo C/estadistica.c",
# libestadistica.c). Lista vacía -> 0.0 (o 0 para enteros).
#
#   importar "estadistica/estadistica" como est
#   decimal m = est.media([1.0, 2.0, 3.0])             # 2.0
#   decimal d = est.desviacion([2,4,4,4,5,5,7,9])      # 2.0
#   entero mn = est.minimo([5, 2, 9, 1])               # 1
#   entero mx = est.maximo([5, 2, 9, 1])               # 9
#
# Los nombres originales (est_*) se mantienen por compatibilidad y
# llaman ahora a la implementación en C.
# =====================================================================

# --- Externas (implementadas en C, ver "codigo C/estadistica.c") ---

externa "est_suma"          como suma(l: lista<decimal>): decimal
externa "est_suma_enteros"  como suma_enteros(l: lista<entero>): entero
externa "est_media"         como media(l: lista<decimal>): decimal
externa "est_media_enteros" como media_enteros(l: lista<entero>): decimal
externa "est_min"           como minimo(l: lista<decimal>): decimal
externa "est_max"           como maximo(l: lista<decimal>): decimal
externa "est_min_entero"    como minimo_entero(l: lista<entero>): entero
externa "est_max_entero"    como maximo_entero(l: lista<entero>): entero
externa "est_varianza"      como varianza(l: lista<decimal>): decimal
externa "est_desviacion"    como desviacion(l: lista<decimal>): decimal
externa "est_mediana"       como mediana(l: lista<decimal>): decimal
externa "est_version"       como estadistica_version(): cadena

# Nota: las funciones con nombre corto (media, minimo, maximo, suma, etc.)
# son las externas C directamente. No hay wrappers Wini adicionales para
# evitar redefinición de símbolos C.
