# =====================================================================
# wmat.cwn — matemáticas para Wini
# ---------------------------------------------------------------------
# Funciones en Wini puro (mantenidas por compatibilidad) más nuevas
# funciones implementadas en C (ver "codigo C/matematicas.c", <math.h>)
# para trigonometría, potencia, raíz, logaritmo y redondeo precisos.
#
#   importar "matematicas/wmat" como m
#   m.seno(0.5)              # seno en radianes
#   m.potencia_decimal(2.0, 10.0)   # 1024.0
#   m.raiz_cuadrada_c(16.0)         # 4.0
#   m.logaritmo(100.0)              # ln(100)
#   m.redondear_decimal(3.7)        # 4.0
#   m.maximo_entero_c(7, 3)         # 7
# =====================================================================

# --- Externas (implementadas en C, ver "codigo C/matematicas.c") ---

# Trigonométrica (radianes).
externa "mat_seno"          como seno(x: decimal): decimal
externa "mat_coseno"        como coseno(x: decimal): decimal
externa "mat_tangente"      como tangente(x: decimal): decimal
externa "mat_arco_seno"     como arco_seno(x: decimal): decimal
externa "mat_arco_coseno"   como arco_coseno(x: decimal): decimal
externa "mat_arco_tangente" como arco_tangente(x: decimal): decimal

# Potencia, raíz, exponencial, logaritmo.
externa "mat_potencia"           como potencia_decimal(base: decimal, exp: decimal): decimal
externa "mat_raiz_cuadrada"      como raiz_cuadrada_c(n: decimal): decimal
externa "mat_exponencial"        como exponencial(x: decimal): decimal
externa "mat_logaritmo"          como logaritmo(x: decimal): decimal
externa "mat_logaritmo10"        como logaritmo10(x: decimal): decimal

# Redondeo (devuelven decimal).
externa "mat_redondear"      como redondear_decimal(x: decimal): decimal
externa "mat_techo"          como techo_decimal(x: decimal): decimal
externa "mat_piso"           como piso_decimal(x: decimal): decimal
externa "mat_abs_decimal"    como abs_decimal_c(n: decimal): decimal

# Enteros.
externa "mat_abs_entero"     como abs_entero_c(n: entero): entero
externa "mat_maximo_entero"  como maximo_entero_c(a: entero, b: entero): entero
externa "mat_minimo_entero"  como minimo_entero_c(a: entero, b: entero): entero

# Versión del módulo.
externa "mat_version"        como modulo_version_c(): cadena

#abs de un numero entero : tipo(entero)
funcion abs_entero(n: entero) -> entero:
    si n < 0:
        retornar -n
    retornar n

funcion signo_entero(n: entero) -> entero:
    si n > 0:
        retornar 1
    si n < 0:
        retornar -1
    retornar 0

funcion menor_entero(a: entero, b: entero) -> entero:
    si a < b:
        retornar a
    retornar b

funcion mayor_entero(a: entero, b: entero) -> entero:
    si a > b:
        retornar a
    retornar b

funcion potencia_entero(base: entero, exp: entero) -> entero:
    si exp < 0:
        retornar 0
    entero r = 1
    entero i = 0
    mientras i < exp:
        r = r*base
        i += 1
    retornar r

funcion factorial(n: entero) -> entero:
    si n < 0:
        retornar 0
    entero r = 1
    entero i = 2
    mientras i <= n:
        r = r*i
        i += 1
    retornar r

funcion mcd(a: entero, b: entero) -> entero:
    entero x = abs_entero(a)
    entero y1 = abs_entero(b)
    mientras y1 != 0:
        entero t = y1
        y1 = x % y1
        x = t
    retornar x

funcion mcm(a: entero, b: entero) -> entero:
    si a == 0 o b == 0:
        retornar 0
    retornar abs_entero(a * b) / mcd(a, b)

funcion es_primo(n: entero) -> booleano:
    si n < 2:
        retornar falso
    si n == 2:
        retornar verdadero
    si n % 2 == 0:
        retornar falso
    entero i = 3
    mientras i * i <= n:
        si n % i == 0:
            retornar falso
        i += 2
    retornar verdadero

funcion es_par(n: entero) -> booleano:
    retornar n % 2 == 0

funcion es_impar(n: entero) -> booleano:
    retornar n % 2 != 0

# --- decimales -----------------------------------------------------------
funcion abs_decimal(n: decimal) -> decimal:
    si n < 0.0:
        retornar -n
    retornar n

funcion menor_decimal(a: decimal, b: decimal) -> decimal:
    si a < b:
        retornar a
    retornar b

funcion mayor_decimal(a: decimal, b: decimal) -> decimal:
    si a > b:
        retornar a
    retornar b

funcion redondear(n: decimal) -> entero:
    si n >= 0.0:
        retornar entero(n + 0.5)
    retornar entero(n - 0.5)

funcion piso(n: decimal) -> entero:
    entero t = entero(n)
    si n < 0.0 y decimal(t) != n:
        retornar t - 1
    retornar t

funcion techo(n: decimal) -> entero:
    entero t = entero(n)
    si n > 0.0 y decimal(t) != n:
        retornar t + 1
    retornar t

funcion raiz_cuadrada(n: decimal) -> decimal:
    si n <= 0.0:
        retornar 0.0
    decimal x = n
    decimal y1 = (x + 1.0) / 2.0
    mientras abs_decimal(y1 - x) > 0.0000001:
        x = y1
        y1 = (x + n / x) / 2.0
    retornar x

funcion sumar(a:entero, b:entero) -> entero:
    retornar a + b

funcion restar(a:entero, b:entero) -> entero:
    retornar a - b

funcion multiplicar(a:entero, b:entero) -> entero:
    retornar a * b

funcion dividir(a:entero, b:entero) -> entero:
    si b == 0:
        escribir("Error: Division por cero")
        retornar 0
    retornar a / b

# --- Nota de uso ---
# Las funciones implementadas en C se llaman directamente con sus nombres
# cortos (son externas registradas en el módulo):
#
#   seno(0.5)              # seno en radianes (C)
#   potencia_decimal(2, 10) # 1024.0 (C)
#   raiz_cuadrada_c(16.0)  # 4.0 (C)
#   redondear_decimal(3.7) # 4.0 (C)
#   techo_decimal(3.2)     # 4.0 (C)
#   piso_decimal(3.2)      # 3.0 (C)
#   abs_decimal_c(-5.5)    # 5.5 (C)
#   logaritmo(100.0)       # ln(100) (C)
#   logaritmo10(100.0)     # 2.0 (C)
#   exponencial(1.0)       # e (C)
#   maximo_entero_c(7, 3)  # 7 (C)
#   minimo_entero_c(7, 3)  # 3 (C)
#   modulo_version()       # versión del módulo (C)
#
# Las funciones en Wini puro de arriba se mantienen por compatibilidad.