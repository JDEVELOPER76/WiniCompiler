#funciones de comparacion con cadenas :string


funcion es_minuscula(value: cadena) ->booleano:
    para char en value:
        si char < 'a' o char > 'z':
            retornar falso
    retornar verdadero

funcion es_mayuscula(value: cadena) ->booleano:
    para char en value:
        si char < 'A' o char > 'Z':
            retornar falso
    retornar verdadero

funcion contiene_minuscula(value:cadena) -> booleano:
    para char en value:
        si char >= 'a' y char <= 'z':
            retornar verdadero
    retornar falso

funcion contiene_mayuscula(value:cadena) -> booleano:
    para char en value:
        si char >= 'A' y char <= 'Z':
            retornar verdadero
    retornar falso


funcion contiene_numero(value: cadena) -> booleano:
    cadena nums = "0123456789"
    para ch en value:
        para num en nums:
            si ch == num:
                retornar verdadero
    retornar falso

funcion empieza_en(value: cadena, param: cadena) -> booleano:
    entero n = long_cadena(param)
    entero m = long_cadena(value)
    si n > m:
        retornar falso
    entero i = 0
    mientras i < n:
        si value[i] != param[i]:
            retornar falso
        i += 1
    retornar verdadero

funcion termina_en(value: cadena, param: cadena) -> booleano:
    entero n = long_cadena(param)
    entero m = long_cadena(value)
    si n > m:
        retornar falso
    entero i = 0
    mientras i < n:
        si value[m - n + i] != param[i]:
            retornar falso
        i += 1
    retornar verdadero

funcion es_vacia(value: cadena) -> booleano:
    retornar long_cadena(value) == 0

funcion es_espacio(value: cadena) -> booleano:
    si long_cadena(value) == 0:
        retornar falso
    para ch en value:
        si ch != " ":
            retornar falso
    retornar verdadero

funcion es_alfabetico(value: cadena) -> booleano:
    si long_cadena(value) == 0:
        retornar falso
    para ch en value:
        si ch >= 'a' y ch <= 'z':
            continuar
        si ch >= 'A' y ch <= 'Z':
            continuar
        retornar falso
    retornar verdadero

funcion es_alfanumerico(value: cadena) -> booleano:
    si long_cadena(value) == 0:
        retornar falso
    para ch en value:
        si ch >= 'a' y ch <= 'z':
            continuar
        si ch >= 'A' y ch <= 'Z':
            continuar
        si ch >= '0' y ch <= '9':
            continuar
        retornar falso
    retornar verdadero

funcion es_numero(value: cadena) -> booleano:
    si long_cadena(value) == 0:
        retornar falso
    para ch en value:
        si ch < '0' o ch > '9':
            retornar falso
    retornar verdadero

funcion a_mayusculas(value: cadena) -> cadena:
    cadena minus = "abcdefghijklmnopqrstuvwxyz"
    cadena mayus = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    cadena resultado = ""
    para ch en value:
        entero idx = indice_de(minus, ch)
        si idx >= 0:
            resultado = resultado + mayus[idx]
        demas:
            resultado = resultado + ch
    retornar resultado

funcion a_minusculas(value: cadena) -> cadena:
    cadena minus = "abcdefghijklmnopqrstuvwxyz"
    cadena mayus = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    cadena resultado = ""
    para ch en value:
        entero idx = indice_de(mayus, ch)
        si idx >= 0:
            resultado = resultado + minus[idx]
        demas:
            resultado = resultado + ch
    retornar resultado

funcion capitalizar(value: cadena) -> cadena:
    si long_cadena(value) == 0:
        retornar ""
    retornar a_mayusculas(value[0]) + a_minusculas(subcadena(value, 1, long_cadena(value)))

funcion invertir_cadena(value: cadena) -> cadena:
    cadena resultado = ""
    entero i = long_cadena(value) - 1
    mientras i >= 0:
        resultado = resultado + value[i]
        i -= 1
    retornar resultado

funcion indice_de(value: cadena, sub: cadena) -> entero:
    entero n = long_cadena(value)
    entero m = long_cadena(sub)
    si m == 0:
        retornar 0
    si m > n:
        retornar -1
    entero i = 0
    mientras i <= n - m:
        si subcadena(value, i, i + m) == sub:
            retornar i
        i += 1
    retornar -1

funcion subcadena(value: cadena, inicio: entero, fin: entero) -> cadena:
    entero n = long_cadena(value)
    si inicio < 0:
        inicio = 0
    si fin > n:
        fin = n
    si inicio >= fin:
        retornar ""
    cadena resultado = ""
    entero i = inicio
    mientras i < fin:
        resultado = resultado + value[i]
        i += 1
    retornar resultado

