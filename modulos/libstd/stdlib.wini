# funcion con utilidades de wini
# usando funciones externas o internas de wini con el puente de C
# Wini <-> C


# Longitudes de tipos básicos de datos 

#agarran de parametros un valor tipado y regresa su valor en formato entero : int

funcion long_cadena(value: cadena) -> entero:
    entero contador = 0
    para char en value:
        contador += 1
    retornar contador


# Longitudes de listas (una por tipo de elemento)


funcion ilong_lista(value: lista<entero>) -> entero:
    entero contador = 0
    para item en value:
        contador += 1
    retornar contador

funcion slong_lista(value: lista<cadena>) -> entero:
    entero contador = 0
    para item en value:
        contador += 1
    retornar contador

funcion dlong_lista(value: lista<decimal>) -> entero:
    entero contador = 0
    para item en value:
        contador += 1
    retornar contador

funcion blong_lista(value: lista<booleano>) -> entero:
    entero contador = 0
    para item en value:
        contador += 1
    retornar contador

funcion agregar_entero(l: lista<entero>, x: entero) -> lista<entero>:
    retornar l + [x]

funcion agregar_cadena(l: lista<cadena>, x: cadena) -> lista<cadena>:
    retornar l + [x]

funcion agregar_decimal(l: lista<decimal>, x: decimal) -> lista<decimal>:
    retornar l + [x]

funcion agregar_booleano(l: lista<booleano>, x: booleano) -> lista<booleano>:
    retornar l + [x]

funcion cadena2lista(value: cadena) -> lista<cadena>:
    lista<cadena> resultado = []
    cadena buffer = ""
    para ch en value:
        si ch == " ":
            si long_cadena(buffer) > 0:
                resultado = resultado + [buffer]
                buffer = ""
        demas:
            buffer = buffer + ch
    si long_cadena(buffer) > 0:
        resultado = resultado + [buffer]
    retornar resultado

funcion lista2cadena(value: lista<cadena>) -> cadena:
    cadena resultado = ""
    para item en value:
        resultado = resultado + item + " "
    retornar resultado


# Longitudes de diccionarios (16 combinaciones clave x valor)
# Esquema de nombres: <clave><valor>long_diccionario
#   c = cadena
#   e = entero
#   d = decimal
#   b = booleano


# --- clave: cadena -------------------------------------------------

funcion cclong_diccionario(value: diccionario<cadena, cadena>) -> entero:
    entero contador = 0
    para clave en value:
        contador += 1
    retornar contador

