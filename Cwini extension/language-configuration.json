{
  "comments": {
    "lineComment": "#"
  },
  "wordPattern": "[a-zA-Z_\\u00C0-\\u017F][\\w\\u00C0-\\u017F]*",
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?!#).*(funcion|estructura|externa|si|sino|demas|mientras|para|intentar|capturar|finalmente)\\b.*:\\s*(?:#.*)?$|^\\s*(?!#).*:\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(sino|demas|capturar|finalmente)\\b.*:\\s*(?:#.*)?$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(sino|demas|capturar|finalmente)\\b.*:\\s*$",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "^\\s*(?!#).*:\\s*(?:#.*)?$",
      "action": { "indent": "indent" }
    }
  ]
}
