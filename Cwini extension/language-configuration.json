{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "c\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "c'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(si|sino|demas|mientras|para|funcion|externa|estructura|intentar|capturar|finalmente)\\b.*:\\s*(#.*)?$|^.*\\{\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(sino|demas|capturar|finalmente)\\b.*:"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(si|sino|demas|mientras|para|funcion|externa|estructura|intentar|capturar|finalmente)\\b.*:\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*(si|sino|demas|mientras|para|funcion|externa|estructura|intentar|capturar|finalmente)\\b.*:\\s*(#.*)?$"
    }
  }
}
