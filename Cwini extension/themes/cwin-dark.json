{
  "name": "Cwin Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#101018",
    "editor.foreground": "#c9d3f0",
    "editorLineNumber.foreground": "#4a5178",
    "editorLineNumber.activeForeground": "#8f97c9",
    "editor.selectionBackground": "#2a3a5c",
    "editor.inactiveSelectionBackground": "#22283f",
    "editor.lineHighlightBackground": "#181827",
    "editorCursor.foreground": "#7dd3fc",
    "editorIndentGuide.background1": "#22233a",
    "editorIndentGuide.activeBackground1": "#3d3f66",
    "editorBracketMatch.border": "#7dd3fc",
    "editorBracketMatch.background": "#22314a",
    "editorWidget.background": "#161624",
    "editorSuggestWidget.background": "#161624",
    "sideBar.background": "#12121c",
    "activityBar.background": "#12121c",
    "statusBar.background": "#161630",
    "statusBar.noFolderBackground": "#161630",
    "titleBar.activeBackground": "#12121c",
    "scrollbarSlider.background": "#2a2a44aa",
    "scrollbarSlider.hoverBackground": "#3a3a5caa"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#6b7394", "fontStyle": "italic" } },
    { "scope": ["comment.line.doc"], "settings": { "foreground": "#8b9cc9", "fontStyle": "italic" } },
    { "scope": ["keyword.control"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["keyword.declaration"], "settings": { "foreground": "#7dd3fc" } },
    { "scope": ["keyword.other"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["keyword.other.builtin"], "settings": { "foreground": "#ff7ab2" } },
    { "scope": ["keyword.operator.logical", "keyword.operator.comparison", "keyword.operator.assignment", "keyword.operator.arithmetic"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["keyword.operator.arrow"], "settings": { "foreground": "#ff9cac" } },
    { "scope": ["storage.type"], "settings": { "foreground": "#4ec9b0" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#ff5874" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#f78c6c" } },
    { "scope": ["string.quoted"], "settings": { "foreground": "#c3e88d" } },
    { "scope": ["string.quoted.interpolated"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["meta.interpolation"], "settings": { "foreground": "#f78c6c" } },
    { "scope": ["punctuation.definition.interpolation"], "settings": { "foreground": "#ff9cac" } },
    { "scope": ["punctuation.definition.brackets"], "settings": { "foreground": "#ffd479" } },
    { "scope": ["punctuation.separator"], "settings": { "foreground": "#ffd479" } },
    { "scope": ["punctuation.accessor"], "settings": { "foreground": "#ff9cac" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#82aaff" } },
    { "scope": ["entity.name.class", "entity.name.type"], "settings": { "foreground": "#2dd4bf" } },
    { "scope": ["entity.name.module"], "settings": { "foreground": "#ffd479" } },
    { "scope": ["support.function"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["support.function.builtin"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["support.function.conversion"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["variable.other"], "settings": { "foreground": "#9dd0ff" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#f78c6c" } }
  ]
}
